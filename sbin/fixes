#! /bin/sh
bash /sbin/usb-dac-no-suspend
bash /sbin/mpd-prio-tweak
bash /sbin/usb-dac-lowlatency-off
bash /sbin/shairport-sync-install
bash /sbin/usbdac-params-sync
bash /sbin/usbdac-db-init
bash /sbin/mpd_update
chmod 777 /etc/modprobe.d/*.conf
chmod -R 777 /mnt/*
(echo rootfs; echo rootfs) | smbpasswd -a -s root

RC="/etc/rc.local"

ETHTOOL_LINE="ethtool -s eth0 speed 100 duplex half"
CHMOD_OK="chmod -R 777 /mnt/*"
CHMOD_BAD="chmod 777 -R /mnt/*"

if [ -f "$RC" ]; then
  if grep -Fq "$ETHTOOL_LINE" "$RC"; then
    sed -i "\|$ETHTOOL_LINE|d" "$RC"
  fi

  if ! grep -Fq "$CHMOD_OK" "$RC" && ! grep -Fq "$CHMOD_BAD" "$RC"; then
    if grep -q '^[[:space:]]*exit 0' "$RC"; then
      sed -i "/^[[:space:]]*exit 0/i\\$CHMOD_OK" "$RC"
    else
      printf '\n%s\n' "$CHMOD_OK" >> "$RC"
    fi
  fi
fi

touch /var/log/lastlog >/dev/null 2>&1
chown root:utmp /var/log/lastlog >/dev/null 2>&1 || chown root:root /var/log/lastlog >/dev/null 2>&1
chmod 664 /var/log/lastlog >/dev/null 2>&1

ln -sfn /dev/null /var/log/debug

exit 0
