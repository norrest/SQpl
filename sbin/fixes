#! /bin/sh
bash /sbin/usb-dac-no-suspend
bash /sbin/mpd-prio-tweak
bash /sbin/usb-dac-lowlatency-off
bash /sbin/shairport-sync-install
bash /sbin/usbdac-params-sync
bash /sbin/usbdac-db-init
bash /sbin/mpd_update
chmod 777 /etc/modprobe.d/*.conf
chmod -R 777 /mnt/*
(echo rootfs; echo rootfs) | smbpasswd -a -s root

RC="/etc/rc.local"
ETHTOOL_LINE="ethtool -s eth0 speed 100 duplex half"
CHMOD_BG='( chmod -R 777 /mnt/* >/dev/null 2>&1 ) &'

if [ -f "$RC" ]; then
  # remove legacy ethtool
  sed -i "\|$ETHTOOL_LINE|d" "$RC" 2>/dev/null || true

  # normalize exit 0 line
  sed -i 's/^[[:space:]]*exit 0.*/exit 0/' "$RC" 2>/dev/null || true

  # drop any old chmod lines for /mnt
  sed -i '/chmod -R 777 \/mnt\/\*/d' "$RC" 2>/dev/null || true

  # add background chmod once
  if ! grep -Fq "$CHMOD_BG" "$RC"; then
    if grep -q '^[[:space:]]*exit 0' "$RC"; then
      sed -i "/^[[:space:]]*exit 0/i\\$CHMOD_BG" "$RC" 2>/dev/null || true
    else
      printf '\n%s\nexit 0\n' "$CHMOD_BG" >> "$RC"
    fi
  fi
fi

# Disable login accounting files (avoid writes to SD)
mkdir -p /etc/tmpfiles.d
rm -f /etc/tmpfiles.d/no-wtmp.conf /etc/tmpfiles.d/no-lastlog.conf 2>/dev/null

# Override default var.conf to avoid wtmp/btmp conflicts
if [ -f /usr/lib/tmpfiles.d/var.conf ]; then
  cp -f /usr/lib/tmpfiles.d/var.conf /etc/tmpfiles.d/var.conf
fi
if [ -f /etc/tmpfiles.d/var.conf ]; then
  sed -i '/^f \/var\/log\/wtmp\b/d;/^f \/var\/log\/btmp\b/d' /etc/tmpfiles.d/var.conf
fi

if command -v systemd-tmpfiles >/dev/null 2>&1; then
  rm -f /var/log/wtmp /var/log/btmp /var/log/lastlog

  cat >/etc/tmpfiles.d/no-login-logs.conf <<'EOF'
L /var/log/wtmp - - - - /dev/null
L /var/log/btmp - - - - /dev/null
L /var/log/lastlog - - - - /dev/null
EOF

  systemd-tmpfiles --create >/dev/null 2>&1 || true
fi

ln -sfn /dev/null /var/log/debug

# Remove ntpd daemon if installed
if dpkg -s ntp >/dev/null 2>&1; then
  DEBIAN_FRONTEND=noninteractive apt-get -y -qq purge ntp >/dev/null 2>&1 || true
  DEBIAN_FRONTEND=noninteractive apt-get -y -qq autoremove --purge >/dev/null 2>&1 || true
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl set-default multi-user.target >/dev/null 2>&1 || true
  systemctl mask display-manager.service >/dev/null 2>&1 || true
fi

# Remove unused bonding module autoload (clean boot logs)
if [ -f /etc/modules ]; then
  sed -i '/^[[:space:]]*bonding[[:space:]]*$/d' /etc/modules 2>/dev/null || true
fi

if [ -f /etc/modules-load.d/modules.conf ]; then
  sed -i '/^[[:space:]]*bonding[[:space:]]*$/d' /etc/modules-load.d/modules.conf 2>/dev/null || true
fi

# Disable NetBIOS and Samba AD DC (keep smbd for \\IP\share)
if command -v systemctl >/dev/null 2>&1; then
  systemctl stop nmbd samba-ad-dc >/dev/null 2>&1 || true
  systemctl disable nmbd samba-ad-dc >/dev/null 2>&1 || true
  systemctl mask nmbd.service samba-ad-dc.service >/dev/null 2>&1 || true
  systemctl daemon-reload >/dev/null 2>&1 || true
fi

if command -v update-rc.d >/dev/null 2>&1; then
  update-rc.d -f nmbd remove >/dev/null 2>&1 || true
  update-rc.d -f samba-ad-dc remove >/dev/null 2>&1 || true
fi

# Speed up smbd start: avoid slow samba-tool (AD DC is never used)
if [ -f /etc/init.d/smbd ] && grep -q 'samba-tool testparm' /etc/init.d/smbd; then
  sed -i 's/samba-tool testparm/testparm -s/g' /etc/init.d/smbd >/dev/null 2>&1 || true
fi

# rc.local: replace "sudo python shapes_and_ip_clone.py" with background run (only if present)
if [ -f "$RC" ] && grep -Fq 'sudo python shapes_and_ip_clone.py' "$RC"; then
  sed -i '/^[[:space:]]*sudo[[:space:]]\+python[[:space:]]\+shapes_and_ip_clone\.py[[:space:]]*$/c\python ./shapes_and_ip_clone.py >/dev/null 2>&1 &' "$RC"
fi

exit 0
