#!/bin/sh
set -e  # Exit on any error
RED=$(tput setaf 1 2>/dev/null || echo "")
RESET=$(tput sgr 0 2>/dev/null || echo "")

echo "${RED}[+] Stop MPD${RESET}"
mpc stop 2>/dev/null || true
systemctl stop mpd.socket mpd 2>/dev/null || true

echo "${RED}[+] Time sync (best-effort)${RESET}"

# Install ntpdate if missing (no apt-get update), ignore install errors
if ! command -v ntpdate >/dev/null 2>&1; then
  apt-get install -y ntpdate >/dev/null 2>&1 || true
fi

# If ntpdate is available, try to sync time, ignore errors
if command -v ntpdate >/dev/null 2>&1; then
  ntpdate -u pool.ntp.org >/dev/null 2>&1 || true
fi

# Save current system time to RTC, ignore errors
hwclock -w >/dev/null 2>&1 || true


echo "${RED}[+] Clone StereoQ player updates${RESET}"
rm -rf /update/tmpi
GIT_SSL_NO_VERIFY=true git clone --depth 1 https://github.com/norrest/SQpl.git /update/tmpi/
chmod -R 777 /update/tmpi

echo "${RED}[+] Install files${RESET}"
rm -rf /etc/apt/sources.list.d/* 2>/dev/null || true
cp -Rf /update/tmpi/etc/* /etc/
cp -Rf /update/tmpi/var/* /var/
cp -Rf /update/tmpi/sbin/* /sbin/
cp -Rf /update/tmpi/bin/* /bin/
cp -Rf /update/tmpi/usr/* /usr/
cp -f /update/tmpi/50x.html /usr/share/nginx/html/
cp -f /update/tmpi/50x.html /etc/nginx/html/

systemctl daemon-reload

[ -f /sbin/fixes ] || { echo "${RED}[!] /sbin/fixes not found${RESET}"; exit 1; }
chmod +x /sbin/fixes 2>/dev/null || true
bash /sbin/fixes

echo "${RED}[+] Cleanup & MPD setup${RESET}"
rm -rf /update/tmpi /sbin/fixes
mkdir -p /var/lib/mpd/playlists /var/lib/mpd/music/WEBRADIO
chmod -R 777 /var/lib/mpd

echo "${RED}[+] Start services${RESET}"
systemctl start mpd

echo '<span style="color:#4da3ff;font-weight:900;">[+] Support: https://norrest.github.io/StereoQ/</span>'
echo '<span style="color:#4da3ff;font-weight:900;">[!] Only if you saw the red warning above: the installation is running in the background. Do not do anything right now. Reboot the player in 5 minutes.</span>'
